# Contact form (frontend only — no backend in this project).
# Set to a hosted form endpoint that accepts a JSON POST and returns 2xx on success
# (e.g. a Formspree form URL https://formspree.io/f/xxxxxxx). Leave empty and the form
# tells visitors it cannot send yet and offers WhatsApp / a pre-filled email instead.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Google Analytics — off unless set. Existing property from the audit: GT-NSL7XN7P (owner decision pending)
NEXT_PUBLIC_GA_ID=
